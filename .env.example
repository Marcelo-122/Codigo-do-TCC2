# Copie este arquivo para ".env" e preencha com os valores da SUA máquina/rede.
# O ".env" está no .gitignore e nunca deve ser commitado.
# Formato CHAVE=VALOR, sem comentário na mesma linha do valor.

# --- Portas seriais (veja as portas disponíveis com: python verify.py) -------
# ESP32-CAM / bridge para o Radioenge
TX_SERIAL_PORT=COM5
# Heltec LoRa32 (receptor)
RX_SERIAL_PORT=COM8

# --- Sessão LoRaWAN ABP (valores do SEU módulo Radioenge) --------------------
# AT+DADDR=?   (4 bytes = 8 caracteres hex)
LORA_DEV_ADDR=00000000
# AT+APPSKEY=? (16 bytes = 32 caracteres hex)
LORA_APP_SKEY=00000000000000000000000000000000

# --- ChirpStack / MQTT (só o mqtt_bridge.py) ---------------------------------
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
CHIRPSTACK_APPLICATION_ID=00000000-0000-0000-0000-000000000000
CHIRPSTACK_DEV_EUI=0000000000000000

# --- Orquestrador (só o orchestrator.py) -------------------------------------
# Imagem a enviar pelo LoRa (caminho relativo à raiz do repositório ou absoluto na SUA máquina)
IMAGE_PATH=image.jpg

# --- Download dos datasets (scripts/download_datasets.py) --------------------
# Token do Kaggle: https://www.kaggle.com/settings/api (Generate New Token).
# Descomente e preencha só quando for baixar; nunca commite o valor real.
# KAGGLE_API_TOKEN=
